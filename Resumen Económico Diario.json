    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\nconst escapeHtml = (str = '') =>\n  String(str)\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;');\n\nconst getSource = (link = '') => {\n  try {\n    return new URL(link).hostname.replace(/^www\\./, '');\n  } catch (e) {\n    return 'Fuente desconocida';\n  }\n};\n\nconst fecha = new Date().toLocaleDateString('es-ES', {\n  weekday: 'long',\n  year: 'numeric',\n  month: 'long',\n  day: 'numeric',\n  timeZone: 'Europe/Madrid',\n});\nconst fechaCap = fecha.charAt(0).toUpperCase() + fecha.slice(1);\n\nconst lista = items\n  .map((item) => {\n    const { title, link } = item.json;\n    if (!title || !link) return '';\n    return `\n      <li style=\"margin-bottom:14px;line-height:1.4;\">\n        <a href=\"${escapeHtml(link)}\" style=\"color:#1a4d8f;text-decoration:none;font-weight:600;\">${escapeHtml(title)}</a>\n        <br>\n        <span style=\"color:#888;font-size:12px;\">${escapeHtml(getSource(link))}</span>\n      </li>`;\n  })\n  .join('');\n\nconst html = `\n<div style=\"background-color:#f5f7fa;padding:24px;font-family:Arial,Helvetica,sans-serif;\">\n  <div style=\"max-width:600px;margin:0 auto;background-color:#ffffff;border-radius:8px;padding:24px;\">\n    <h1 style=\"margin:0 0 4px 0;font-size:22px;color:#222;\">☕ Tu resumen económico de hoy</h1>\n    <p style=\"margin:0 0 20px 0;color:#888;font-size:13px;\">${escapeHtml(fechaCap)}</p>\n    <ul style=\"padding-left:20px;margin:0;font-size:15px;color:#333;\">\n      ${lista}\n    </ul>\n  </div>\n</div>`;\n\nreturn [{ json: { html } }];"
      },
